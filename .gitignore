# ====================================================================
# ARCHIVOS DE COMPILACIÓN (MAVEN / JAVA)
# ====================================================================
# Ignora la carpeta donde Maven compila el código, baja dependencias temporales y guarda capturas
target/
*.class
*.jar
*.war
*.ear

# ====================================================================
# CONFIGURACIÓN DEL IDE (INTELLIJ IDEA)
# ====================================================================
# Ignora las preferencias del espacio de trabajo personal de IntelliJ
.idea/
*.iml
*.iws
*.ipr
out/

# Si compartes el proyecto en equipo, puedes conservar los diccionarios o estilos,
# pero por ahora es mejor ignorar todo .idea para evitar conflictos de rutas locales.

# ====================================================================
# REPORTES Y RESULTADOS DE PRUEBAS
# ====================================================================
# Ignora los reportes locales generados. Allure se compila dinámicamente,
# no queremos subir miles de archivos HTML/JSON al repositorio.
allure-report/
.allure/
test-output/
isuite-results/

# Nota: Dejamos fuera 'target/allure-results' de forma segura ya que toda la carpeta 
# 'target/' está ignorada en la primera sección.

# ====================================================================
# ESPECÍFICO DE MACOS (SISTEMA OPERATIVO)
# ====================================================================
# Archivos ocultos que macOS genera automáticamente al navegar por las carpetas
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# ====================================================================
# LOGS Y CACHÉ
# ====================================================================
*.log
.bsp/
.scandir